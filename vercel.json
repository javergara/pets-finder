{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd src/web && npm ci && npm run build",
  "outputDirectory": "src/web/dist",
  "framework": null,
  "crons": [{ "path": "/api/radar", "schedule": "0 11 * * *" }],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    {
      "source": "/fotos/:nombre",
      "destination": "https://edizovmcsdpfblfmyccu.supabase.co/storage/v1/object/public/fotos/:nombre"
    },
    {
      "source": "/(cali|armenia|pereira|manizales|quibdo|bogota|medellin)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot).*"
        }
      ],
      "destination": "/api/index"
    },
    {
      "source": "/reporte/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot).*"
        }
      ],
      "destination": "/api/index"
    },
    {
      "source": "/adoptar/mascota/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot).*"
        }
      ],
      "destination": "/api/index"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/fotos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
